# ============================================================
#  LLM 配置模板
# ------------------------------------------------------------
#  用法：
#      1. 复制这个文件为 .env
#      2. 把你实际使用的那一组「取消注释」并填入真实 Key
#      3. .env 已在 .gitignore 中，绝不会被提交到 Git
#
#  ⚠️ 真正起作用的只有 3 个概念，代码完全与厂商无关：
#        密钥   ← 代码按优先级依次尝试 DEEPSEEK_API_KEY → LLM_API_KEY → OPENAI_API_KEY
#        接口地址 ← LLM_BASE_URL（不填则默认 https://api.deepseek.com）
#        模型名  ← LLM_MODEL
# ============================================================


# ---------- 方案 A：DeepSeek（✅ 当前选用 · 国内直连，无需代理）----------
# 控制台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里填入你的DeepSeekKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 想用推理模型（更强但要先思考、更慢更贵）可换成：deepseek-reasoner

# ---------- 方案 B：阿里云百炼（Qwen）----------
# 控制台：https://bailian.console.aliyun.com/
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ---------- 方案 C：智谱 GLM ----------
# 控制台：https://open.bigmodel.cn/
# DEEPSEEK_API_KEY=xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ---------- 方案 D：Moonshot Kimi ----------
# 控制台：https://platform.moonshot.cn/
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# ---------- 方案 E：OpenAI 官方（需要代理）----------
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---------- 方案 F：本地 Ollama（完全离线，不需要花钱）----------
# 先执行：ollama pull qwen2.5:7b
# DEEPSEEK_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b


# ============================================================
#  可调参数（都有默认值，不填也能跑）
# ============================================================

# 采样温度 0~2：越小越稳定严谨，越大越发散有创意
LLM_TEMPERATURE=0.7

# 单次请求超时（秒）
LLM_TIMEOUT=60

# 流式模式下是否请求 token 用量统计
# 大多数厂商（含 DeepSeek）支持；若报错改成 false 即可
LLM_STREAM_USAGE=true
